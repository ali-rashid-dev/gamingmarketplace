// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserRole {
  BUYER
  SELLER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum GameStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD_OUT
  REMOVED
}

enum DeliveryType {
  INSTANT
  MANUAL
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum OrderItemStatus {
  PENDING
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  ACCEPTED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  BUYER_FAVOR
  SELLER_FAVOR
  CLOSED
}

enum DisputeReasonCode {
  NOT_DELIVERED
  INVALID_GOODS
  NOT_AS_DESCRIBED
  OTHER
}

enum DisputeDecision {
  FULL_REFUND
  PARTIAL_REFUND
  RELEASE_TO_SELLER
  NO_FINANCIAL_ADJUSTMENT
  OTHER
}

enum DisputeEventType {
  OPENED
  MESSAGE
  EVIDENCE_ADDED
  ASSIGNED
  EVIDENCE_REQUESTED
  ESCALATED
  DECIDED
  APPEALED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerSourceType {
  ORDER
  PAYMENT
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum NotificationType {
  ORDER_UPDATE
  MESSAGE
  PAYMENT_UPDATE
  REVIEW
  DISPUTE_UPDATE
  SELLER_UPDATE
  SYSTEM
  DELIVERY_UPDATE
  WITHDRAWAL_UPDATE
  SUPPORT_UPDATE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  DEAD
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportReportCategory {
  ABUSE
  SCAM
  HARASSMENT
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum SupportReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReviewReportReason {
  ABUSE
  HARASSMENT
  SPAM
  FRAUD
  OTHER
}

enum ConversationReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ConversationReportReason {
  ABUSE
  HARASSMENT
  SPAM
  FRAUD
  OTHER
}

model User {
  id                          String                 @id
  name                        String
  email                       String                 @unique
  emailVerified               Boolean
  image                       String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  sessions                    Session[]
  accounts                    Account[]
  profile                     AccountProfile?
  sellerProfile               SellerProfile?
  orders                      Order[]                @relation("OrderBuyer")
  buyerConversations          Conversation[]         @relation("ConversationBuyer")
  sellerConversations         Conversation[]         @relation("ConversationSeller")
  messages                    Message[]
  conversationReports         ConversationReport[]   @relation("ConversationReporter")
  reviewedConversationReports ConversationReport[]   @relation("ConversationReportReviewer")
  reviews                     Review[]               @relation("ReviewBuyer")
  reviewReports               ReviewReport[]
  openedDisputes              Dispute[]              @relation("DisputeOpener")
  assignedDisputes            Dispute[]              @relation("DisputeAssignee")
  disputeMessages             DisputeMessage[]
  disputeEvents               DisputeEvent[]
  submittedEvidence           DisputeEvidence[]
  notifications               Notification[]
  notificationOutbox          NotificationOutbox[]
  auditLogs                   AuditLog[]             @relation("AuditActor")
  listingRevisions            ListingRevision[]
  wishlistItems               WishlistItem[]
  supportTickets              SupportTicket[]        @relation("SupportTicketOpener")
  assignedSupportTickets      SupportTicket[]        @relation("SupportTicketAssignee")
  supportMessages             SupportTicketMessage[] @relation("SupportMessageSender")
  supportAgentProfile         SupportAgentProfile?
  roleAssignments             UserRoleAssignment[]
  submittedSupportReports     SupportReport[]        @relation("SupportReportSubmitter")
  reportedBySupportReports    SupportReport[]        @relation("SupportReportSubject")
  assignedSupportReports      SupportReport[]        @relation("SupportReportAssignee")
  commissionRulesCreated      CommissionRule[]       @relation("CommissionRuleCreator")
  withdrawalEvents            WithdrawalEvent[]

  @@map("user")
}

model Role {
  id          String               @id @default(cuid())
  key         UserRole             @unique
  assignments UserRoleAssignment[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permission")
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId, createdAt])
  @@map("user_role_assignment")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model AccountProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  username           String   @unique
  displayName        String?
  bio                String?
  locale             String   @default("en")
  preferredCurrency  String   @default("USD") @db.Char(3)
  emailNotifications Boolean  @default(true)
  countryCode        String?  @db.Char(2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  shopName          String
  slug              String             @unique
  description       String?
  status            SellerStatus       @default(PENDING)
  isAvailable       Boolean            @default(true)
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  listings          Listing[]
  orderItems        OrderItem[]
  reviews           Review[]
  ledgerEntries     LedgerEntry[]
  withdrawals       Withdrawal[]
  sellerCommissions SellerCommission[]

  @@index([status, createdAt])
}

model Game {
  id             String     @id @default(cuid())
  name           String     @unique
  slug           String     @unique
  description    String?
  logoUrl        String?
  coverImageUrl  String?
  seoTitle       String?
  seoDescription String?
  status         GameStatus @default(DRAFT)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  categories     Category[]
  listings       Listing[]

  @@index([status, name])
}

model Category {
  id          String          @id @default(cuid())
  gameId      String
  name        String
  slug        String
  type        String
  description String?
  platforms   String[]        @default([])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Restrict)
  listings    Listing[]
  fields      CategoryField[]

  @@unique([gameId, slug])
  @@unique([id, gameId])
  @@index([gameId, type, isActive])
}

model CategoryField {
  id         String            @id @default(cuid())
  categoryId String
  key        String
  label      String
  type       CategoryFieldType @default(TEXT)
  isRequired Boolean           @default(false)
  options    Json              @default("[]")
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model Listing {
  id               String                   @id @default(cuid())
  sellerId         String
  gameId           String
  categoryId       String
  title            String
  description      String
  price            Decimal                  @db.Decimal(12, 2)
  currency         String                   @default("USD") @db.Char(3)
  quantity         Int                      @default(1)
  platform         String?
  region           String?
  deliveryType     DeliveryType             @default(MANUAL)
  deliveryEstimate String?
  expiresAt        DateTime?
  reviewNote       String?
  status           ListingStatus            @default(DRAFT)
  images           Json                     @default("[]")
  searchVector     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(description, ''::text)))"))
  publishedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  seller           SellerProfile            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  game             Game                     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  category         Category                 @relation(fields: [categoryId, gameId], references: [id, gameId], onDelete: Restrict)
  attributes       ListingAttribute[]
  revisions        ListingRevision[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]

  @@index([gameId, categoryId, status, publishedAt])
  @@index([sellerId, status, createdAt])
  @@index([status, price])
  @@index([status, expiresAt])
  @@index([searchVector], type: Gin)
}

model ListingAttribute {
  id        String   @id @default(cuid())
  listingId String
  key       String
  label     String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, key])
  @@index([key])
}

model ListingRevision {
  id             String   @id @default(cuid())
  listingId      String
  revisionNumber Int
  changedById    String
  snapshot       Json
  createdAt      DateTime @default(now())
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy      User     @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([listingId, revisionNumber])
  @@index([changedById, createdAt])
}

model Order {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  buyerId        String
  status         OrderStatus     @default(AWAITING_PAYMENT)
  subtotal       Decimal         @db.Decimal(12, 2)
  fees           Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  currency       String          @default("USD") @db.Char(3)
  placedAt       DateTime        @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  buyer          User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  deliveries     Delivery[]
  messages       Message[]
  conversations  Conversation[]
  disputes       Dispute[]
  supportTickets SupportTicket[]
  supportReports SupportReport[]

  @@index([buyerId, status, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id              String            @id @default(cuid())
  orderId         String
  listingId       String?
  sellerId        String
  listingTitle    String
  listingSnapshot Json
  unitPrice       Decimal           @db.Decimal(12, 2)
  quantity        Int
  totalPrice      Decimal           @db.Decimal(12, 2)
  currency        String            @db.Char(3)
  status          OrderItemStatus   @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing         Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  seller          SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  deliveries      Delivery[]
  disputes        Dispute[]
  review          Review?
  commission      SellerCommission?
  ledgerEntries   LedgerEntry[]

  @@index([orderId])
  @@index([sellerId, status, createdAt])
  @@index([listingId])
}

model Payment {
  id                          String        @id @default(cuid())
  orderId                     String
  provider                    String
  providerReference           String?
  status                      PaymentStatus @default(PENDING)
  amount                      Decimal       @db.Decimal(12, 2)
  currency                    String        @db.Char(3)
  metadata                    Json?
  paidAt                      DateTime?
  settledAt                   DateTime?
  providerSettlementReference String?       @unique
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  order                       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model Delivery {
  id           String         @id @default(cuid())
  orderId      String
  orderItemId  String?
  status       DeliveryStatus @default(PENDING)
  instructions String?
  details      Json?
  deliveredAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([orderItemId])
}

model Conversation {
  id        String               @id @default(cuid())
  buyerId   String
  sellerId  String
  orderId   String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  buyer     User                 @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User                 @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  order     Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages  Message[]
  reports   ConversationReport[]

  // The orderless buyer-seller unique index is partial and is managed by migration SQL.
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([orderId])
}

model ConversationReport {
  id             String                   @id @default(cuid())
  conversationId String
  reporterId     String
  reason         ConversationReportReason
  details        String?
  status         ConversationReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter       User                     @relation("ConversationReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewedBy     User?                    @relation("ConversationReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([conversationId, reporterId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  orderId        String?
  body           String
  attachments    Json         @default("[]")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([orderId, createdAt])
  @@index([senderId, createdAt])
}

model Review {
  id                String         @id @default(cuid())
  orderItemId       String         @unique
  buyerId           String
  sellerId          String
  listingId         String?
  rating            Int
  comment           String?
  status            ReviewStatus   @default(PUBLISHED)
  sellerResponse    String?
  sellerRespondedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orderItem         OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  buyer             User           @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller            SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  listing           Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reports           ReviewReport[]

  @@index([sellerId, status, createdAt])
  @@index([sellerId, rating])
  @@index([listingId, createdAt])
}

model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String
  reporterId String
  reason     ReviewReportReason
  details    String?
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User               @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model Dispute {
  id             String            @id @default(cuid())
  orderId        String
  orderItemId    String?
  openedById     String
  assignedToId   String?
  status         DisputeStatus     @default(OPEN)
  reasonCode     DisputeReasonCode @default(OTHER)
  reason         String
  description    String
  decision       DisputeDecision?
  decisionAmount Decimal?          @db.Decimal(12, 2)
  resolution     String?
  resolvedAt     DateTime?
  appealedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  openedBy       User              @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  assignedTo     User?             @relation("DisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  evidence       DisputeEvidence[]
  messages       DisputeMessage[]
  events         DisputeEvent[]

  @@index([orderId, status])
  @@index([assignedToId, status, updatedAt])
  @@index([orderItemId, status])
  @@index([status, createdAt])
  @@index([openedById, createdAt])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@index([senderId, createdAt])
}

model DisputeEvent {
  id        String           @id @default(cuid())
  disputeId String
  actorId   String
  type      DisputeEventType
  details   Json?
  createdAt DateTime         @default(now())
  dispute   Dispute          @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
}

model DisputeEvidence {
  id            String   @id @default(cuid())
  disputeId     String
  submittedById String
  url           String
  description   String?
  name          String?
  contentType   String?
  size          Int?
  createdAt     DateTime @default(now())
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
}

model LedgerEntry {
  id             String           @id @default(cuid())
  sellerId       String
  type           LedgerEntryType
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @db.Char(3)
  sourceType     LedgerSourceType
  sourceId       String
  description    String?
  createdAt      DateTime         @default(now())
  availableAt    DateTime?
  idempotencyKey String           @unique
  orderItemId    String?
  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([sourceType, sourceId])
  @@index([sellerId, currency, availableAt])
  @@index([orderItemId])
}

model Withdrawal {
  id                String            @id @default(cuid())
  sellerId          String
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @db.Char(3)
  status            WithdrawalStatus  @default(REQUESTED)
  providerReference String?           @unique
  requestedAt       DateTime          @default(now())
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  seller            SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  events            WithdrawalEvent[]

  @@index([sellerId, status, requestedAt])
  @@index([status, requestedAt])
}

model CommissionRule {
  id          String             @id @default(cuid())
  basisPoints Int
  effectiveAt DateTime
  createdById String
  createdAt   DateTime           @default(now())
  createdBy   User               @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  commissions SellerCommission[]

  @@index([effectiveAt])
}

model SellerCommission {
  id               String         @id @default(cuid())
  orderItemId      String         @unique
  sellerId         String
  commissionRuleId String
  grossAmount      Decimal        @db.Decimal(12, 2)
  commissionAmount Decimal        @db.Decimal(12, 2)
  sellerNet        Decimal        @db.Decimal(12, 2)
  currency         String         @db.Char(3)
  createdAt        DateTime       @default(now())
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  seller           SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  commissionRule   CommissionRule @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([currency, createdAt])
}

model WithdrawalEvent {
  id                String           @id @default(cuid())
  withdrawalId      String
  actorId           String
  status            WithdrawalStatus
  providerReference String?
  details           String?
  createdAt         DateTime         @default(now())
  withdrawal        Withdrawal       @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor             User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id             String              @id @default(cuid())
  userId         String
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String
  body           String
  data           Json?
  idempotencyKey String?             @unique
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox         NotificationOutbox?

  @@index([userId, readAt, createdAt])
  @@index([channel, sentAt])
}

model NotificationOutbox {
  id             String                   @id @default(cuid())
  userId         String
  notificationId String                   @unique
  dedupeKey      String                   @unique
  status         NotificationOutboxStatus @default(PENDING)
  attempts       Int                      @default(0)
  availableAt    DateTime                 @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, lockedAt])
  @@index([userId, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model SupportTicket {
  id           String                 @id @default(cuid())
  userId       String
  assignedToId String?
  orderId      String?
  subject      String
  status       SupportTicketStatus    @default(OPEN)
  priority     SupportTicketPriority  @default(NORMAL)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  resolvedAt   DateTime?
  user         User                   @relation("SupportTicketOpener", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]

  @@index([userId, status, updatedAt])
  @@index([orderId])
  @@index([assignedToId, status, updatedAt])
  @@index([status, priority, updatedAt])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([senderId, createdAt])
}

model SupportAgentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportReport {
  id             String                @id @default(cuid())
  submittedById  String
  reportedUserId String?
  assignedToId   String?
  orderId        String?
  category       SupportReportCategory
  status         SupportReportStatus   @default(OPEN)
  details        String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  submittedBy    User                  @relation("SupportReportSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reportedUser   User?                 @relation("SupportReportSubject", fields: [reportedUserId], references: [id], onDelete: SetNull)
  assignedTo     User?                 @relation("SupportReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([assignedToId, status, updatedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
